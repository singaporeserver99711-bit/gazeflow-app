<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GazeFlow Controller"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hands-Free YouTube Shorts Scrolling"
            android:textColor="#10B981"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_status_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Appear on Top: Checking..."
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_status_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Accessibility Service: Checking..."
                android:textColor="#E0E0E0"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Permission Buttons -->
        <Button
            android:id="@+id/btn_grant_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant 'Appear on top' Permission"
            android:backgroundTint="#374151"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_grant_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Accessibility Settings"
            android:backgroundTint="#374151"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_test_gesture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Test Swipe Gesture (Verify Service)"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_start_bubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Start Floating Bubble"
            android:backgroundTint="#10B981"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_stop_bubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏹ Stop / Remove Floating Bubble"
            android:backgroundTint="#EF4444"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to use:\n1. Tap 'Start Floating Bubble'\n2. Open YouTube Shorts\n3. Tap the floating eye bubble anytime to swipe to the next Short!\n4. Long-press the bubble to close it."
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
